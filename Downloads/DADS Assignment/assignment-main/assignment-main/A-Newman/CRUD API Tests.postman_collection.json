          "listen": "test",
          "script": {
            "exec": [
              "// Feature Covered: Test Assertions & Variable Chaining\r",
              "pm.test(\"Status code is 201 Created\", () => {\r",
              "  pm.response.to.have.status(201);\r",
              "});\r",
              "\r",
              "const response = pm.response.json();\r",
              "\r",
              "pm.test(\"Response contains new user ID\", () => {\r",
              "  pm.expect(response).to.have.property(\"id\");\r",
              "});\r",
              "\r",
              "// Save ID for subsequent requests\r",
              "pm.environment.set(\"userId\", response.id);\r",
              ""
